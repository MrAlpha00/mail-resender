# Resend
# Server-only API key. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=
#
# The sender is fixed in the application as: MailDrop <no-reply@maildrops.online>
# The maildrops.online domain must be verified in Resend before delivery.

# Upstash Redis (persistent rate limiting and daily quota)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (private temporary attachment storage)
# Create a private Blob store named maildrop-attachments and connect it to the project.
# Vercel injects this token automatically when the store is connected.
BLOB_READ_WRITE_TOKEN=

# Vercel Cron authentication for /api/blob/cleanup
# Set a long random value in Vercel. Vercel sends it as: Authorization: Bearer <value>
CRON_SECRET=

# Optional application settings
# Maximum unique recipients per submission (1-50). Defaults to 15.
MAX_RECIPIENTS=15
# Global daily recipient ceiling across all visitors. Defaults to 500.
GLOBAL_DAILY_RECIPIENT_LIMIT=500
# Optional salt for hashing IP addresses in abuse-monitoring logs.
ABUSE_HASH_SALT=
# Public site URL used in the email footer. Example: https://maildrops.online
NEXT_PUBLIC_APP_URL=http://localhost:3000
