# ── Resend ─────────────────────────────────────────────────────────────────────
# Server-only API key. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=
# The verified sender on a domain you control in Resend.
# Example: noreply@yourdomain.com
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=MailDrop

# ── Cloudflare Turnstile ───────────────────────────────────────────────────────
# Site key is public and rendered in the browser. Secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: restrict verification to your production hostname.
# TURNSTILE_EXPECTED_HOSTNAME=maildrop.example.com

# ── Upstash Redis (persistent rate limiting) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Application settings ───────────────────────────────────────────────────────
# Maximum unique recipients per submission (1–50). Defaults to 15.
MAX_RECIPIENTS=15
# Global daily recipient ceiling across all visitors. Defaults to 500.
GLOBAL_DAILY_RECIPIENT_LIMIT=500
# Optional salt for hashing IP addresses in abuse-monitoring logs.
ABUSE_HASH_SALT=
# Public site URL used in the email footer. Example: https://maildrop.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
